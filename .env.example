# Copy this file to .env and fill the values before running the parser

# Groq API Key (required) — get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Token (required) — get from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (required) — get from @userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here